# =============================================================================
# EXEMPLO DE CONFIGURAÇÃO - IndustryOS Backend
# =============================================================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha os valores conforme seu ambiente
# 3. NUNCA commite o arquivo .env real (já está no .gitignore)
#
# =============================================================================

# =============================================================================
# AMBIENTE
# =============================================================================
# Opções: development, staging, production, test
ENVIRONMENT=development

# Modo debug (True=logs detalhados, auto-reload)
DEBUG=true

# =============================================================================
# BANCO DE DADOS
# =============================================================================
# SQLite (desenvolvimento)
DATABASE_URL=sqlite:///./data/industryos.db

# PostgreSQL (futuro produção)
# DATABASE_URL=postgresql://user:password@localhost:5432/industryos

# Logar queries SQL (útil para debug)
DATABASE_ECHO=false

# Tamanho do pool de conexões (PostgreSQL futuro)
DATABASE_POOL_SIZE=5

# =============================================================================
# SEGURANÇA (Futura Implementação JWT)
# =============================================================================
# Chave secreta para JWT (mínimo 32 caracteres em produção!)
SECRET_KEY=dev-secret-key-change-in-production-32chars-long

# Tempo de expiração do token em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Origens permitidas para requisições (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Permitir credenciais (cookies)
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# FINANCEIRO
# =============================================================================
# Saldo inicial padrão para projeções
DEFAULT_INITIAL_BALANCE=10000

# Limites de margem de lucro (%)
MARGIN_HEALTH_EXCELLENT=15
MARGIN_HEALTH_ATTENTION=5

# =============================================================================
# PAGINAÇÃO
# =============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# DADOS DE TESTE
# =============================================================================
# Executar seed automático em desenvolvimento?
SEED_DATA=true
